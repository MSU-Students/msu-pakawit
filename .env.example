# MSU Pakawit - Root Environment Configuration Example

# API Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=msu_pakawit_local_dev_jwt_secret_2026
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
BOOTSTRAP_ADMIN_SECRET=replace_with_a_long_random_development_secret

# Database Configuration (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=msu_pakawit_db
DATABASE_SYNCHRONIZE=true

# Email registration
APP_BASE_URL=http://localhost:3000
VERIFICATION_TOKEN_TTL_HOURS=24
ALLOWED_EMAIL_DOMAINS=
PASSWORD_MIN_LENGTH=8
EMAIL_PROVIDER=local
EMAIL_FROM=MSU Pakawit <no-reply@localhost>
LOCAL_MAILBOX_DIR=.local-mailbox

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_TITLE=MSU Pakawit
